# Copie este archivo como .env y complete los valores reales.
# El archivo .env NUNCA debe subirse a git ni compartirse.
PORT=3000
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sivep
# Puerto del servidor MySQL. Local: 3306. Aiven u otro remoto: el indicado
# en su panel (p. ej. 18082).
MYSQL_PORT=3306
# TLS para la conexión MySQL. Local: false. Remotos con TLS (Aiven): true.
MYSQL_SSL=false
# Secreto para firmar los JWT. Genere uno largo y aleatorio, p. ej.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
UPLOAD_PATH=./uploads
# Orígenes permitidos para el frontend, separados por coma (producción).
# Vacío = permite todo (solo para desarrollo local).
CORS_ORIGIN=
# Forzar redirección de HTTP a HTTPS. Activar solo en producción detrás
# de un proxy TLS (Nginx/Caddy). En desarrollo local debe ser false.
FORCE_HTTPS=false
# Credenciales de Cloudinary (solo backend, jamás exponer en el frontend).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=