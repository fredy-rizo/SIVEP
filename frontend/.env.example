# Copie este archivo como .env y ajuste la URL del backend.
# El archivo .env NUNCA debe subirse a git ni compartirse.
# URL base de la API (debe incluir el sufijo /api).
VITE_API_URL=http://localhost:3000/api
# Página de pago virtual de la UNAL donde se realizan las compras en línea.
VITE_ECOLLECT_PURCHASE_URL=https://pagovirtual.unal.edu.co/index.php
# Opcional: URL del canal WebSocket (ej. ws://localhost:3000/ws). Si se omite,
# se deriva de VITE_API_URL cambiando http→ws y usando la ruta /ws.
VITE_WS_URL=
